# Grafana Cloud OTLP credentials (Connections > OpenTelemetry (OTLP) integration)
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_INSTANCE_ID=<your-instance-id>
GRAFANA_OTLP_TOKEN=<your-write-token>

# pipeline.briefing: where to publish snapshots. Must be a local checkout of
# a SEPARATE pitwall-data repo (typically served via GitHub Pages) -- never
# a path inside this project's own checkout; the code refuses to commit/push
# if it resolves there. If this isn't set, briefing writes to a local-only
# ./pitwall-briefing-output directory and never attempts to publish.
PITWALL_DATA_REPO=<path to your local pitwall-data checkout, e.g. /home/you/pitwall-data>

# Set at most ONE of the two auth options below. If neither is set, briefing
# writes local files only and skips the git push (safe default, e.g. for
# local dev/testing).
# Option A: a fine-grained GitHub PAT with contents:write on pitwall-data
PITWALL_DATA_TOKEN=
# Option B: an SSH deploy key with write access, path to the private key file
PITWALL_DATA_DEPLOY_KEY_PATH=
