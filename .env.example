# Grafana Cloud OTLP credentials (Connections > OpenTelemetry (OTLP) integration)
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_INSTANCE_ID=<your-instance-id>
GRAFANA_OTLP_TOKEN=<your-write-token>

# pipeline.briefing: where to publish snapshots (a separate pitwall-data
# repo, typically served via GitHub Pages). Set at most ONE of the two auth
# options below; if neither is set, briefing writes local files only and
# skips the git push (safe default, e.g. for local dev/testing).
PITWALL_DATA_REPO=/home/rouaa/Desktop/pitwall-data# Option A: a fine-grained GitHub PAT with contents:write on pitwall-data
PITWALL_DATA_TOKEN=
# Option B: an SSH deploy key with write access, path to the private key file